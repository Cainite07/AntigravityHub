<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AntigravityHub</RootNamespace>
    <AssemblyName>AntigravityHub</AssemblyName>
    <Version>2.23.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns startup; WinForms is used only for tray/screen helpers. Set DPI before WPF creates an HWND. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../client/maintenance/tools/**" Exclude="../../client/maintenance/tools/node_modules/**;../../client/maintenance/tools/__pycache__/**" Link="client/maintenance/tools/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../client/release-2.22.0/source/hans/**" Link="client/release-2.22.0/source/hans/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- WPF content URIs use Assembly.Location, which is empty in a bundle.
         The embedded Resource above supplies the window icon for single-file builds. -->
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" Condition="'$(PublishSingleFile)' != 'true'" />
    <Content Include="integration\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**" Exclude="wwwroot\real_data.json;wwwroot\tailwindcss.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
